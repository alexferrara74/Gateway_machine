PORT=3000

# Read-only ERP database account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=az1
DB_POOL_SIZE=5

# Servizi_Pilot destination database.
DB_NUOVO_HOST=127.0.0.1
DB_NUOVO_PORT=3306
DB_NUOVO_USER=
DB_NUOVO_PASSWORD=
DB_NUOVO_NAME=service
DB_NUOVO_POOL_SIZE=10

# Product catalog categories: article category IDs (artclscid), comma-separated.
SYNC_PRODOTTI_CATEGORIE_IDS=

# Equipment selection by ERP class codes and exact class:subclass code pairs.
SYNC_ATTREZZATURE_CLASSI=
SYNC_ATTREZZATURE_SOTTOCLASSI=

# Subclasses (class:subclass) of the equipment selection that are accessories:
# they are not written to local_attrezzature and get is_accessorio=1.
SYNC_ACCESSORI_SOTTOCLASSI=

SYNC_FATTURE_DA_ANNO=2011

CRON_ENABLED=true
CRON_SCHEDULE=0 2 * * *
